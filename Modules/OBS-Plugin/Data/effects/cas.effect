//---------------------------------------------------------------------------------------------------------------------
//    Platform Detection & Includes
//---------------------------------------------------------------------------------------------------------------------
// _OPENGL is defined by OBS for OpenGL backends (Linux, legacy macOS)
// For Metal (modern macOS) and D3D11 (Windows), we use simplified inline implementation
// because Metal cannot handle the complex AMD FidelityFX headers

#ifdef _OPENGL
#include "ffx_a_mod.h"
#endif

//---------------------------------------------------------------------------------------------------------------------
//    Uniforms, Constants & Samplers
//---------------------------------------------------------------------------------------------------------------------

uniform float4x4 ViewProj;
uniform texture2d image; 

#ifdef _OPENGL
uniform AF2 output_size;
uniform AF4 cas_const_1;
#else
uniform float2 output_size;
uniform float4 cas_const_1;
#endif

sampler_state PointSampler 
{
    Filter      = Point; 
    AddressU    = Clamp;
    AddressV    = Clamp;
};

//---------------------------------------------------------------------------------------------------------------------
//    Vertex Shader
//---------------------------------------------------------------------------------------------------------------------

struct VSData 
{
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VSData VSMain(VSData vs)
{
    VSData vs_out;
    vs_out.pos = mul(float4(vs.pos.xyz, 1.0), ViewProj);
    vs_out.uv  = vs.uv;
    return vs_out;
}

//---------------------------------------------------------------------------------------------------------------------
//    OpenGL Implementation (uses AMD FidelityFX headers)
//---------------------------------------------------------------------------------------------------------------------
#ifdef _OPENGL

AF3 CasLoad(ASU2 p)
{   
    AF2 uv = (AF2(p) + AF2_(0.5)) / output_size;
    return image.Sample(PointSampler, uv).rgb;
}

void CasInput(inout AF1 r, inout AF1 g, inout AF1 b){ /* UNUSED */ }

#define CAS_SLOW
#define CAS_BETTER_DIAGONALS
#include "ffx_cas_mod.h"

#else
//---------------------------------------------------------------------------------------------------------------------
//    Metal/D3D11 Implementation (simplified inline, no external headers)
//---------------------------------------------------------------------------------------------------------------------

float Min3F(float a, float b, float c)
{
    return min(a, min(b, c));
}

float Max3F(float a, float b, float c)
{
    return max(a, max(b, c));
}

float3 LoadPixel(int2 p)
{
    float2 uv = (float2(p) + 0.5) / output_size;
    return image.Sample(PointSampler, uv).rgb;
}

float3 CasFilterInline(float2 ip, float4 const1)
{
    int2 sp = int2(ip);
    
    // 3x3 neighborhood
    float3 a = LoadPixel(sp + int2(-1, -1));
    float3 b = LoadPixel(sp + int2(0, -1));
    float3 c = LoadPixel(sp + int2(1, -1));
    float3 d = LoadPixel(sp + int2(-1, 0));
    float3 e = LoadPixel(sp);
    float3 f = LoadPixel(sp + int2(1, 0));
    float3 g = LoadPixel(sp + int2(-1, 1));
    float3 h = LoadPixel(sp + int2(0, 1));
    float3 i = LoadPixel(sp + int2(1, 1));
    
    // Soft min and max using cross pattern + diagonals
    float mnR = Min3F(Min3F(d.r, e.r, f.r), b.r, h.r);
    float mnG = Min3F(Min3F(d.g, e.g, f.g), b.g, h.g);
    float mnB = Min3F(Min3F(d.b, e.b, f.b), b.b, h.b);
    
    float mnR2 = Min3F(Min3F(mnR, a.r, c.r), g.r, i.r);
    float mnG2 = Min3F(Min3F(mnG, a.g, c.g), g.g, i.g);
    float mnB2 = Min3F(Min3F(mnB, a.b, c.b), g.b, i.b);
    mnR = mnR + mnR2;
    mnG = mnG + mnG2;
    mnB = mnB + mnB2;
    
    float mxR = Max3F(Max3F(d.r, e.r, f.r), b.r, h.r);
    float mxG = Max3F(Max3F(d.g, e.g, f.g), b.g, h.g);
    float mxB = Max3F(Max3F(d.b, e.b, f.b), b.b, h.b);
    
    float mxR2 = Max3F(Max3F(mxR, a.r, c.r), g.r, i.r);
    float mxG2 = Max3F(Max3F(mxG, a.g, c.g), g.g, i.g);
    float mxB2 = Max3F(Max3F(mxB, a.b, c.b), g.b, i.b);
    mxR = mxR + mxR2;
    mxG = mxG + mxG2;
    mxB = mxB + mxB2;
    
    // Reciprocal of max
    float rcpMR = 1.0 / (mxR + 0.0001);
    float rcpMG = 1.0 / (mxG + 0.0001);
    float rcpMB = 1.0 / (mxB + 0.0001);
    
    // Amplitude
    float ampR = saturate(min(mnR, 2.0 - mxR) * rcpMR);
    float ampG = saturate(min(mnG, 2.0 - mxG) * rcpMG);
    float ampB = saturate(min(mnB, 2.0 - mxB) * rcpMB);
    
    // Shape amplitude
    ampR = sqrt(ampR);
    ampG = sqrt(ampG);
    ampB = sqrt(ampB);
    
    // Filter weights
    float peak = const1.x;
    float wR = ampR * peak;
    float wG = ampG * peak;
    float wB = ampB * peak;
    
    // Apply filter using per-channel weights
    float rcpWeightR = 1.0 / (1.0 + 4.0 * wR);
    float rcpWeightG = 1.0 / (1.0 + 4.0 * wG);
    float rcpWeightB = 1.0 / (1.0 + 4.0 * wB);
    
    float3 pix;
    pix.r = saturate((b.r * wR + d.r * wR + f.r * wR + h.r * wR + e.r) * rcpWeightR);
    pix.g = saturate((b.g * wG + d.g * wG + f.g * wG + h.g * wG + e.g) * rcpWeightG);
    pix.b = saturate((b.b * wB + d.b * wB + f.b * wB + h.b * wB + e.b) * rcpWeightB);
    
    return pix;
}

#endif

//---------------------------------------------------------------------------------------------------------------------
//    Pixel Shader
//---------------------------------------------------------------------------------------------------------------------

float4 PSMain(VSData vs) : TARGET
{
#ifdef _OPENGL
    AF3 col = AF3(0, 0, 0);
    AF2 pos = floor(vs.uv * output_size.xy); 

    CasFilter(col.r, col.g, col.b, pos, cas_const_1);

    return float4(col, 1.0);
#else
    float2 pos = floor(vs.uv * output_size.xy);
    float3 col = CasFilterInline(pos, cas_const_1);
    return float4(col, 1.0);
#endif
}

//---------------------------------------------------------------------------------------------------------------------
//    Techniques
//---------------------------------------------------------------------------------------------------------------------

technique Draw
{
    pass
    {
        vertex_shader = VSMain(vs);
        pixel_shader  = PSMain(vs);
    }
}
