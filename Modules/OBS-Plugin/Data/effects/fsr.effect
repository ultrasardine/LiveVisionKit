//---------------------------------------------------------------------------------------------------------------------
//    Platform Detection & Includes
//---------------------------------------------------------------------------------------------------------------------
// _OPENGL is defined by OBS for OpenGL backends (Linux, legacy macOS)
// For Metal (modern macOS) and D3D11 (Windows), we use simplified inline implementation
// because Metal cannot handle the complex AMD FidelityFX headers

#ifdef _OPENGL
#include "ffx_a_mod.h"
#endif

//---------------------------------------------------------------------------------------------------------------------
//    Uniforms, Constants & Samplers
//---------------------------------------------------------------------------------------------------------------------

uniform float4x4 ViewProj;
uniform texture2d image; 

#ifdef _OPENGL
uniform AF2 input_size;
uniform AF2 output_size;
uniform AF2 region_uv_offset;

uniform AF4 easu_const_0;
uniform AF4 easu_const_1;
uniform AF4 easu_const_2;
uniform AF4 easu_const_3;
uniform AF4 rcas_const_0;
#else
uniform float2 input_size;
uniform float2 output_size;
uniform float2 region_uv_offset;

uniform float4 easu_const_0;
uniform float4 easu_const_1;
uniform float4 easu_const_2;
uniform float4 easu_const_3;
uniform float4 rcas_const_0;
#endif

sampler_state LinearSampler 
{
    Filter      = Linear; 
    AddressU    = Clamp;
    AddressV    = Clamp;
};

sampler_state PointSampler 
{
    Filter      = Point; 
    AddressU    = Clamp;
    AddressV    = Clamp;
};

//---------------------------------------------------------------------------------------------------------------------
//    Vertex Shader
//---------------------------------------------------------------------------------------------------------------------

struct VSData 
{
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VSData VSMain(VSData vs)
{
    VSData vs_out;
    vs_out.pos = mul(float4(vs.pos.xyz, 1.0), ViewProj);
    vs_out.uv  = vs.uv;
    return vs_out;
}

//---------------------------------------------------------------------------------------------------------------------
//    OpenGL Implementation (uses AMD FidelityFX headers)
//---------------------------------------------------------------------------------------------------------------------
#ifdef _OPENGL

// The textureGather (GLSL 400) and Gather*** (HLSL 5+) functions which are ideally
// required for these functions are not supported. So we instead mimic the functionality 
// by using point sampling.  
//
// For a given point p in normalized texture coordinates. We want to grab neighbouring
// texels x, y, z, and w in the listed order.
//
//                                  +---+---+
//                                  | w | z |
//                                  +--(p)--+
//                                  | x | y |
//                                  +---+---+
//
// To get the normalized texture coordinates for each required texel, we offset 
// point p by half the texel size using addition/subtraction as necessary.
AF4 FsrEasuRF(AF2 p)
{
    AF2 half_texel_size = AF2_(0.5) / input_size;

	p += region_uv_offset;
    return AF4(
        image.Sample(PointSampler, AF2(p.x - half_texel_size.x, p.y + half_texel_size.y)).r,
        image.Sample(PointSampler, AF2(p.x + half_texel_size.x, p.y + half_texel_size.y)).r,
        image.Sample(PointSampler, AF2(p.x + half_texel_size.x, p.y - half_texel_size.y)).r,
        image.Sample(PointSampler, AF2(p.x - half_texel_size.x, p.y - half_texel_size.y)).r
    );
}

AF4 FsrEasuGF(AF2 p)
{
    AF2 half_texel_size = AF2_(0.5) / input_size;

	p += region_uv_offset;
    return AF4(
        image.Sample(PointSampler, AF2(p.x - half_texel_size.x, p.y + half_texel_size.y)).g,
        image.Sample(PointSampler, AF2(p.x + half_texel_size.x, p.y + half_texel_size.y)).g,
        image.Sample(PointSampler, AF2(p.x + half_texel_size.x, p.y - half_texel_size.y)).g,
        image.Sample(PointSampler, AF2(p.x - half_texel_size.x, p.y - half_texel_size.y)).g
    );
}

AF4 FsrEasuBF(AF2 p)
{
    AF2 half_texel_size = AF2_(0.5) / input_size;

	p += region_uv_offset;
    return AF4(
        image.Sample(PointSampler, AF2(p.x - half_texel_size.x, p.y + half_texel_size.y)).b,
        image.Sample(PointSampler, AF2(p.x + half_texel_size.x, p.y + half_texel_size.y)).b,
        image.Sample(PointSampler, AF2(p.x + half_texel_size.x, p.y - half_texel_size.y)).b,
        image.Sample(PointSampler, AF2(p.x - half_texel_size.x, p.y - half_texel_size.y)).b
    );
}

AF4 FsrRcasLoadF(ASU2 p)
{   
    AF2 uv = (AF2(p) + AF2_(0.5)) / input_size;
    return image.Sample(PointSampler, uv);
}

void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b){ /* UNUSED */ }

#include "ffx_fsr1_mod.h"

#else
//---------------------------------------------------------------------------------------------------------------------
//    Metal/D3D11 Implementation (simplified inline, no external headers)
//---------------------------------------------------------------------------------------------------------------------

float3 Min3(float3 a, float3 b, float3 c)
{
    return min(a, min(b, c));
}

float3 Max3(float3 a, float3 b, float3 c)
{
    return max(a, max(b, c));
}

float Min3F(float a, float b, float c)
{
    return min(a, min(b, c));
}

float Max3F(float a, float b, float c)
{
    return max(a, max(b, c));
}

float4 SampleInput(float2 uv)
{
    return image.Sample(PointSampler, uv + region_uv_offset);
}

float4 GatherR(float2 p)
{
    float2 ht = 0.5 / input_size;
    return float4(
        SampleInput(float2(p.x - ht.x, p.y + ht.y)).r,
        SampleInput(float2(p.x + ht.x, p.y + ht.y)).r,
        SampleInput(float2(p.x + ht.x, p.y - ht.y)).r,
        SampleInput(float2(p.x - ht.x, p.y - ht.y)).r
    );
}

float4 GatherG(float2 p)
{
    float2 ht = 0.5 / input_size;
    return float4(
        SampleInput(float2(p.x - ht.x, p.y + ht.y)).g,
        SampleInput(float2(p.x + ht.x, p.y + ht.y)).g,
        SampleInput(float2(p.x + ht.x, p.y - ht.y)).g,
        SampleInput(float2(p.x - ht.x, p.y - ht.y)).g
    );
}

float4 GatherB(float2 p)
{
    float2 ht = 0.5 / input_size;
    return float4(
        SampleInput(float2(p.x - ht.x, p.y + ht.y)).b,
        SampleInput(float2(p.x + ht.x, p.y + ht.y)).b,
        SampleInput(float2(p.x + ht.x, p.y - ht.y)).b,
        SampleInput(float2(p.x - ht.x, p.y - ht.y)).b
    );
}

void EasuTap(
    inout float3 aC,
    inout float aW,
    float2 off,
    float2 dir,
    float2 len,
    float lob,
    float clp,
    float3 c)
{
    float2 v;
    v.x = (off.x * dir.x) + (off.y * dir.y);
    v.y = (off.x * (-dir.y)) + (off.y * dir.x);
    v = v * len;
    float d2 = v.x * v.x + v.y * v.y;
    d2 = min(d2, clp);
    
    float wB = 0.4 * d2 - 1.0;
    float wA = lob * d2 - 1.0;
    wB = wB * wB;
    wA = wA * wA;
    wB = 1.5625 * wB - 0.5625;
    float w = wB * wA;
    
    aC = aC + c * w;
    aW = aW + w;
}

void EasuSet(
    inout float2 dir,
    inout float len,
    float2 pp,
    bool biS, bool biT, bool biU, bool biV,
    float lA, float lB, float lC, float lD, float lE)
{
    float w = 0.0;
    if (biS) w = (1.0 - pp.x) * (1.0 - pp.y);
    if (biT) w = pp.x * (1.0 - pp.y);
    if (biU) w = (1.0 - pp.x) * pp.y;
    if (biV) w = pp.x * pp.y;
    
    float dc = lD - lC;
    float cb = lC - lB;
    float lenX = max(abs(dc), abs(cb));
    lenX = (lenX > 0.0) ? (1.0 / lenX) : 0.0;
    float dirX = lD - lB;
    dir.x = dir.x + dirX * w;
    lenX = saturate(abs(dirX) * lenX);
    lenX = lenX * lenX;
    len = len + lenX * w;
    
    float ec = lE - lC;
    float ca = lC - lA;
    float lenY = max(abs(ec), abs(ca));
    lenY = (lenY > 0.0) ? (1.0 / lenY) : 0.0;
    float dirY = lE - lA;
    dir.y = dir.y + dirY * w;
    lenY = saturate(abs(dirY) * lenY);
    lenY = lenY * lenY;
    len = len + lenY * w;
}

float3 FsrEasuInline(float2 ip, float4 con0, float4 con1, float4 con2, float4 con3)
{
    float2 pp = ip * con0.xy + con0.zw;
    float2 fp = floor(pp);
    pp = pp - fp;
    
    float2 p0 = fp * con1.xy + con1.zw;
    float2 p1 = p0 + con2.xy;
    float2 p2 = p0 + con2.zw;
    float2 p3 = p0 + con3.xy;
    
    float4 bczzR = GatherR(p0);
    float4 bczzG = GatherG(p0);
    float4 bczzB = GatherB(p0);
    float4 ijfeR = GatherR(p1);
    float4 ijfeG = GatherG(p1);
    float4 ijfeB = GatherB(p1);
    float4 klhgR = GatherR(p2);
    float4 klhgG = GatherG(p2);
    float4 klhgB = GatherB(p2);
    float4 zzonR = GatherR(p3);
    float4 zzonG = GatherG(p3);
    float4 zzonB = GatherB(p3);
    
    float4 bczzL = bczzB * 0.5 + (bczzR * 0.5 + bczzG);
    float4 ijfeL = ijfeB * 0.5 + (ijfeR * 0.5 + ijfeG);
    float4 klhgL = klhgB * 0.5 + (klhgR * 0.5 + klhgG);
    float4 zzonL = zzonB * 0.5 + (zzonR * 0.5 + zzonG);
    
    float bL = bczzL.x;
    float cL = bczzL.y;
    float iL = ijfeL.x;
    float jL = ijfeL.y;
    float fL = ijfeL.z;
    float eL = ijfeL.w;
    float kL = klhgL.x;
    float lL = klhgL.y;
    float hL = klhgL.z;
    float gL = klhgL.w;
    float oL = zzonL.z;
    float nL = zzonL.w;
    
    float2 dir = float2(0.0, 0.0);
    float len = 0.0;
    EasuSet(dir, len, pp, true,  false, false, false, bL, eL, fL, gL, jL);
    EasuSet(dir, len, pp, false, true,  false, false, cL, fL, gL, hL, kL);
    EasuSet(dir, len, pp, false, false, true,  false, fL, iL, jL, kL, nL);
    EasuSet(dir, len, pp, false, false, false, true,  gL, jL, kL, lL, oL);
    
    float2 dir2 = dir * dir;
    float dirR = dir2.x + dir2.y;
    bool zro = dirR < (1.0 / 32768.0);
    dirR = rsqrt(dirR);
    dirR = zro ? 1.0 : dirR;
    dir.x = zro ? 1.0 : dir.x;
    dir = dir * dirR;
    
    len = len * 0.5;
    len = len * len;
    
    float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
    float2 len2 = float2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
    float lob = 0.5 + (0.21 - 0.5) * len;
    float clp = 1.0 / lob;
    
    float3 min4 = min(Min3(float3(ijfeR.z, ijfeG.z, ijfeB.z), float3(klhgR.w, klhgG.w, klhgB.w), float3(ijfeR.y, ijfeG.y, ijfeB.y)),
                      float3(klhgR.x, klhgG.x, klhgB.x));
    float3 max4 = max(Max3(float3(ijfeR.z, ijfeG.z, ijfeB.z), float3(klhgR.w, klhgG.w, klhgB.w), float3(ijfeR.y, ijfeG.y, ijfeB.y)),
                      float3(klhgR.x, klhgG.x, klhgB.x));
    
    float3 aC = float3(0.0, 0.0, 0.0);
    float aW = 0.0;
    EasuTap(aC, aW, float2(0.0, -1.0) - pp, dir, len2, lob, clp, float3(bczzR.x, bczzG.x, bczzB.x));
    EasuTap(aC, aW, float2(1.0, -1.0) - pp, dir, len2, lob, clp, float3(bczzR.y, bczzG.y, bczzB.y));
    EasuTap(aC, aW, float2(-1.0, 1.0) - pp, dir, len2, lob, clp, float3(ijfeR.x, ijfeG.x, ijfeB.x));
    EasuTap(aC, aW, float2(0.0, 1.0) - pp, dir, len2, lob, clp, float3(ijfeR.y, ijfeG.y, ijfeB.y));
    EasuTap(aC, aW, float2(0.0, 0.0) - pp, dir, len2, lob, clp, float3(ijfeR.z, ijfeG.z, ijfeB.z));
    EasuTap(aC, aW, float2(-1.0, 0.0) - pp, dir, len2, lob, clp, float3(ijfeR.w, ijfeG.w, ijfeB.w));
    EasuTap(aC, aW, float2(1.0, 1.0) - pp, dir, len2, lob, clp, float3(klhgR.x, klhgG.x, klhgB.x));
    EasuTap(aC, aW, float2(2.0, 1.0) - pp, dir, len2, lob, clp, float3(klhgR.y, klhgG.y, klhgB.y));
    EasuTap(aC, aW, float2(2.0, 0.0) - pp, dir, len2, lob, clp, float3(klhgR.z, klhgG.z, klhgB.z));
    EasuTap(aC, aW, float2(1.0, 0.0) - pp, dir, len2, lob, clp, float3(klhgR.w, klhgG.w, klhgB.w));
    EasuTap(aC, aW, float2(1.0, 2.0) - pp, dir, len2, lob, clp, float3(zzonR.z, zzonG.z, zzonB.z));
    EasuTap(aC, aW, float2(0.0, 2.0) - pp, dir, len2, lob, clp, float3(zzonR.w, zzonG.w, zzonB.w));
    
    return min(max4, max(min4, aC / aW));
}

float4 LoadPixel(int2 p)
{
    float2 uv = (float2(p) + 0.5) / input_size;
    return image.Sample(PointSampler, uv);
}

float3 FsrRcasInline(float2 ip, float4 con)
{
    int2 sp = int2(ip);
    float3 b = LoadPixel(sp + int2(0, -1)).rgb;
    float3 d = LoadPixel(sp + int2(-1, 0)).rgb;
    float3 e = LoadPixel(sp).rgb;
    float3 f = LoadPixel(sp + int2(1, 0)).rgb;
    float3 h = LoadPixel(sp + int2(0, 1)).rgb;
    
    float bL = b.b * 0.5 + (b.r * 0.5 + b.g);
    float dL = d.b * 0.5 + (d.r * 0.5 + d.g);
    float eL = e.b * 0.5 + (e.r * 0.5 + e.g);
    float fL = f.b * 0.5 + (f.r * 0.5 + f.g);
    float hL = h.b * 0.5 + (h.r * 0.5 + h.g);
    
    float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
    float maxL = Max3F(Max3F(bL, dL, eL), fL, hL);
    float minL = Min3F(Min3F(bL, dL, eL), fL, hL);
    nz = saturate(abs(nz) / (maxL - minL + 0.0001));
    nz = -0.5 * nz + 1.0;
    
    float mn4R = min(Min3F(b.r, d.r, f.r), h.r);
    float mn4G = min(Min3F(b.g, d.g, f.g), h.g);
    float mn4B = min(Min3F(b.b, d.b, f.b), h.b);
    float mx4R = max(Max3F(b.r, d.r, f.r), h.r);
    float mx4G = max(Max3F(b.g, d.g, f.g), h.g);
    float mx4B = max(Max3F(b.b, d.b, f.b), h.b);
    
    float hitMinR = min(mn4R, e.r) / (4.0 * mx4R + 0.0001);
    float hitMinG = min(mn4G, e.g) / (4.0 * mx4G + 0.0001);
    float hitMinB = min(mn4B, e.b) / (4.0 * mx4B + 0.0001);
    float hitMaxR = (1.0 - max(mx4R, e.r)) / (4.0 * mn4R - 4.0 + 0.0001);
    float hitMaxG = (1.0 - max(mx4G, e.g)) / (4.0 * mn4G - 4.0 + 0.0001);
    float hitMaxB = (1.0 - max(mx4B, e.b)) / (4.0 * mn4B - 4.0 + 0.0001);
    
    float lobeR = max(-hitMinR, hitMaxR);
    float lobeG = max(-hitMinG, hitMaxG);
    float lobeB = max(-hitMinB, hitMaxB);
    float lobe = max(-0.1875, min(Max3F(lobeR, lobeG, lobeB), 0.0)) * con.x;
    
    float rcpL = 1.0 / (4.0 * lobe + 1.0);
    float3 pix;
    pix.r = (lobe * b.r + lobe * d.r + lobe * h.r + lobe * f.r + e.r) * rcpL;
    pix.g = (lobe * b.g + lobe * d.g + lobe * h.g + lobe * f.g + e.g) * rcpL;
    pix.b = (lobe * b.b + lobe * d.b + lobe * h.b + lobe * f.b + e.b) * rcpL;
    return pix;
}

#endif

//---------------------------------------------------------------------------------------------------------------------
//    EASU Pixel Shader
//---------------------------------------------------------------------------------------------------------------------

float4 EASUPSMain(VSData vs) : TARGET
{
#ifdef _OPENGL
    AF3 col = AF3(0, 0, 0);
    AF2 pos = floor(vs.uv * output_size.xy); 

    FsrEasuF(col, pos, easu_const_0, easu_const_1, easu_const_2, easu_const_3);

    return float4(col, 1.0);
#else
    float2 pos = floor(vs.uv * output_size.xy);
    float3 col = FsrEasuInline(pos, easu_const_0, easu_const_1, easu_const_2, easu_const_3);
    return float4(col, 1.0);
#endif
}

//---------------------------------------------------------------------------------------------------------------------
//    RCAS Pixel Shader
//---------------------------------------------------------------------------------------------------------------------

float4 RCASPSMain(VSData vs) : TARGET
{
#ifdef _OPENGL
    AF3 col = AF3(0, 0, 0);
    AF2 pos = floor(vs.uv * output_size.xy);
   
    FsrRcasF(col.r, col.g, col.b, pos, rcas_const_0);

    return float4(col, 1.0);
#else
    float2 pos = floor(vs.uv * output_size.xy);
    float3 col = FsrRcasInline(pos, rcas_const_0);
    return float4(col, 1.0);
#endif
}

//---------------------------------------------------------------------------------------------------------------------
//    Techniques
//---------------------------------------------------------------------------------------------------------------------

technique EASU
{
    pass
    {
        vertex_shader = VSMain(vs);
        pixel_shader  = EASUPSMain(vs);
    }
};

technique RCAS
{
    pass
    {
        vertex_shader = VSMain(vs);
        pixel_shader  = RCASPSMain(vs);
    }
};
